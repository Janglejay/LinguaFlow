#!/bin/zsh

set -u

target_volume=${3:-/}
target_root=${target_volume%/}
[[ -n "$target_root" ]] || target_root=/

chinese_app="$target_root/Library/Input Methods/LinguaFlow.app"
english_app="$target_root/Library/Input Methods/LinguaFlowEnglish.app"
chinese_binary="$chinese_app/Contents/MacOS/LinguaFlowIME"
english_binary="$english_app/Contents/MacOS/LinguaFlowEnglishIME"
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

if [[ "$target_root" != / ]]; then
  echo "LinguaFlow was installed on $target_root; input-source registration is deferred." >&2
  exit 0
fi

console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
if [[ -z "$console_user" || "$console_user" == root || "$console_user" == loginwindow ]]; then
  echo "No logged-in desktop user; LinguaFlow will be available after the next login." >&2
  exit 0
fi

console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null || true)
console_gid=$(/usr/bin/id -g "$console_user" 2>/dev/null || true)
if [[ -z "$console_uid" || -z "$console_gid" ]]; then
  echo "Could not resolve the logged-in user's uid or gid; registration is deferred." >&2
  exit 0
fi

user_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null \
  | /usr/bin/awk '{ $1=""; sub(/^ /, ""); print }')
if [[ -z "$user_home" ]]; then
  echo "Could not resolve the logged-in user's home directory." >&2
  exit 1
fi

run_as_console_user() {
  /bin/launchctl asuser "$console_uid" \
    /usr/bin/sudo -H -u "$console_user" "$@"
}

bundle_identifier() {
  local bundle=$1
  /usr/libexec/PlistBuddy \
    -c 'Print :CFBundleIdentifier' "$bundle/Contents/Info.plist" 2>/dev/null
}

backup_stamp=$(/bin/date -u '+%Y%m%dT%H%M%SZ')-$$
legacy_backup_base="$user_home/Library/Application Support/LinguaFlow/Legacy Input Methods Backup"
new_backup_root="$user_home/Library/Application Support/LinguaFlow/Input Method Backups/$backup_stamp"
migration_list=
cleanup() {
  [[ -z "$migration_list" ]] || /bin/rm -f "$migration_list"
}
trap cleanup EXIT

move_user_owned_bundle() {
  local bundle=$1
  local destination=$2
  local destination_parent="${destination:h}"
  local source_identity
  local destination_identity
  local source_identifier
  local destination_identifier
  local source_device
  local destination_device

  source_identity=$(/usr/bin/stat -f '%d:%i' "$bundle" 2>/dev/null) || return 1
  source_identifier=$(bundle_identifier "$bundle" || true)
  [[ -n "$source_identifier" ]] || return 1
  source_device=${source_identity%%:*}
  if ! run_as_console_user /bin/mkdir -p "$destination_parent"; then
    echo "Could not create LinguaFlow backup directory: $destination_parent" >&2
    return 1
  fi
  if [[ ! -d "$destination_parent" || -L "$destination_parent" ]]; then
    echo "LinguaFlow backup parent is not a safe directory: $destination_parent" >&2
    return 1
  fi
  destination_device=$(/usr/bin/stat -f '%d' "$destination_parent" 2>/dev/null) || return 1
  if [[ "$source_device" != "$destination_device" ]]; then
    echo "Refusing a cross-device legacy input-method move: $bundle" >&2
    return 1
  fi
  if [[ -e "$destination" || -L "$destination" ]]; then
    echo "LinguaFlow backup destination already exists: $destination" >&2
    return 1
  fi
  if ! run_as_console_user /bin/mv -hn "$bundle" "$destination"; then
    echo "Could not move legacy input method as the logged-in user: $bundle" >&2
    return 1
  fi
  if [[ -e "$bundle" || -L "$bundle" || ! -d "$destination" || -L "$destination" ]]; then
    echo "Legacy input-method move did not complete: $bundle" >&2
    return 1
  fi
  destination_identity=$(/usr/bin/stat -f '%d:%i' "$destination" 2>/dev/null) || return 1
  if [[ "$destination_identity" != "$source_identity" ]]; then
    echo "Legacy input-method identity changed while moving: $bundle" >&2
    return 1
  fi
  destination_identifier=$(bundle_identifier "$destination" || true)
  if [[ "$destination_identifier" != "$source_identifier" ]]; then
    echo "Legacy input-method identifier changed while moving: $bundle" >&2
    return 1
  fi
  echo "Moved legacy input method to $destination"
}

prepare_root_owned_legacy_bundle() {
  local bundle=$1
  local expected_identifier
  local expected_executable
  local parent_directory
  local source_identity
  local updated_identity
  local source_flags
  local actual_identifier
  local actual_version
  local actual_build
  local actual_executable

  # Version 0.2.0 could install a root-owned app in the user's Input Methods
  # directory. Change ownership only on the validated top-level directory, never
  # recursively, then return to the unprivileged move path.
  case "$bundle" in
    "$user_home/Library/Input Methods/LinguaFlow.app")
      expected_identifier=com.fufangjie.inputmethod.LinguaFlow
      expected_executable=LinguaFlowIME
      ;;
    "$user_home/Library/Input Methods/LinguaFlowEnglish.app")
      expected_identifier=com.fufangjie.inputmethod.LinguaFlowEnglish
      expected_executable=LinguaFlowEnglishIME
      ;;
    *)
      echo "Refusing to change ownership outside a fixed legacy path: $bundle" >&2
      return 1
      ;;
  esac

  for parent_directory in \
    "$user_home" \
    "$user_home/Library" \
    "$user_home/Library/Input Methods"; do
    if [[ ! -d "$parent_directory" || -L "$parent_directory" ]]; then
      echo "Legacy input-method parent chain is not safe: $parent_directory" >&2
      return 1
    fi
  done

  [[ -d "$bundle" && ! -L "$bundle" && \
     -f "$bundle/Contents/Info.plist" && \
     ! -L "$bundle/Contents/Info.plist" ]] || return 1
  [[ "$(/usr/bin/stat -f '%u' "$bundle" 2>/dev/null)" == 0 ]] || return 1
  source_flags=$(/usr/bin/stat -f '%f' "$bundle" 2>/dev/null) || return 1
  if [[ "$source_flags" != 0 ]]; then
    echo "Root-owned legacy input method has unsupported file flags: $bundle" >&2
    return 1
  fi

  actual_identifier=$(bundle_identifier "$bundle" || true)
  actual_version=$(/usr/libexec/PlistBuddy \
    -c 'Print :CFBundleShortVersionString' "$bundle/Contents/Info.plist" 2>/dev/null || true)
  actual_build=$(/usr/libexec/PlistBuddy \
    -c 'Print :CFBundleVersion' "$bundle/Contents/Info.plist" 2>/dev/null || true)
  actual_executable=$(/usr/libexec/PlistBuddy \
    -c 'Print :CFBundleExecutable' "$bundle/Contents/Info.plist" 2>/dev/null || true)
  if [[ "$actual_identifier" != "$expected_identifier" || \
        "$actual_version" != 0.2.0 || "$actual_build" != 4 || \
        "$actual_executable" != "$expected_executable" ]]; then
    echo "Root-owned input method is not the known 0.2.0 legacy bundle: $bundle" >&2
    return 1
  fi

  source_identity=$(/usr/bin/stat -f '%d:%i' "$bundle" 2>/dev/null) || return 1
  if ! /usr/sbin/chown -h "$console_uid:$console_gid" "$bundle"; then
    echo "Could not prepare root-owned legacy input method for migration: $bundle" >&2
    return 1
  fi
  updated_identity=$(/usr/bin/stat -f '%d:%i' "$bundle" 2>/dev/null) || return 1
  if [[ "$updated_identity" != "$source_identity" || \
        "$(/usr/bin/stat -f '%u:%g' "$bundle" 2>/dev/null)" != \
          "$console_uid:$console_gid" ]]; then
    echo "Legacy input-method ownership change could not be verified: $bundle" >&2
    return 1
  fi
}

move_validated_legacy_bundle() {
  local bundle=$1
  local user_destination=$2
  local owner_uid

  owner_uid=$(/usr/bin/stat -f '%u' "$bundle" 2>/dev/null) || return 1
  if [[ "$owner_uid" == "$console_uid" ]]; then
    move_user_owned_bundle "$bundle" "$user_destination"
  elif [[ "$owner_uid" == 0 ]]; then
    prepare_root_owned_legacy_bundle "$bundle" || return 1
    move_user_owned_bundle "$bundle" "$user_destination"
  else
    echo "Legacy input method has an unexpected owner ($owner_uid): $bundle" >&2
    return 1
  fi
}

neutralize_registered_backup() {
  local bundle=$1
  local expected_identifier=$2
  local actual_identifier
  local disabled_bundle="$bundle.disabled"

  [[ -d "$bundle" && ! -L "$bundle" && -f "$bundle/Contents/Info.plist" ]] || return 0
  actual_identifier=$(bundle_identifier "$bundle" || true)
  [[ "$actual_identifier" == "$expected_identifier" ]] || return 0

  if [[ -e "$disabled_bundle" || -L "$disabled_bundle" ]]; then
    disabled_bundle="$bundle.disabled-$backup_stamp"
  fi
  move_validated_legacy_bundle "$bundle" "$disabled_bundle" || return 1
}

# Version 0.2.0 preserved migrated bundles with an .app suffix, which lets
# LaunchServices rediscover them. Only exact LinguaFlow bundle IDs are touched.
if [[ -e "$legacy_backup_base" || -L "$legacy_backup_base" ]]; then
  if [[ ! -d "$legacy_backup_base" || -L "$legacy_backup_base" ]]; then
    echo "Legacy LinguaFlow backup location is not a safe directory." >&2
    exit 1
  fi

  migration_list=$(/usr/bin/mktemp \
    /private/tmp/com.fufangjie.LinguaFlow.migration.XXXXXX) || exit 1
  if ! /usr/bin/find -P "$legacy_backup_base" -type d \
    \( -name LinguaFlow.app -o -name LinguaFlowEnglish.app \) \
    -prune -print0 > "$migration_list"; then
    echo "Could not inspect legacy LinguaFlow backups safely." >&2
    exit 1
  fi

  while IFS= read -r -d '' backup_bundle; do
    case "${backup_bundle:t}" in
      LinguaFlow.app)
        expected_identifier=com.fufangjie.inputmethod.LinguaFlow
        ;;
      LinguaFlowEnglish.app)
        expected_identifier=com.fufangjie.inputmethod.LinguaFlowEnglish
        ;;
      *)
        echo "Unexpected legacy backup path: $backup_bundle" >&2
        exit 1
        ;;
    esac
    neutralize_registered_backup "$backup_bundle" "$expected_identifier" || exit 1
  done < "$migration_list"

  /bin/rm -f "$migration_list"
  migration_list=
fi

migrate_legacy_bundle() {
  local bundle_name=$1
  local expected_identifier=$2
  local legacy_bundle="$user_home/Library/Input Methods/$bundle_name"
  local actual_identifier
  local backup_name="${bundle_name%.app}.app.disabled"

  if [[ ! -e "$legacy_bundle" && ! -L "$legacy_bundle" ]]; then
    return 0
  fi

  if [[ ! -d "$legacy_bundle" || -L "$legacy_bundle" || \
        ! -f "$legacy_bundle/Contents/Info.plist" ]]; then
    echo "Legacy input-method path is not a safe application bundle: $legacy_bundle" >&2
    return 1
  fi

  actual_identifier=$(bundle_identifier "$legacy_bundle" || true)
  [[ "$actual_identifier" == "$expected_identifier" ]] || return 0

  if ! move_validated_legacy_bundle \
    "$legacy_bundle" "$new_backup_root/$backup_name"; then
    echo "Could not move legacy $bundle_name; the installation cannot continue safely." >&2
    return 1
  fi
}

migrate_legacy_bundle \
  LinguaFlow.app com.fufangjie.inputmethod.LinguaFlow || exit 1
migrate_legacy_bundle \
  LinguaFlowEnglish.app com.fufangjie.inputmethod.LinguaFlowEnglish || exit 1

if [[ -x "$lsregister" ]]; then
  run_as_console_user "$lsregister" -f "$chinese_app" >/dev/null 2>&1 || true
  run_as_console_user "$lsregister" -f "$english_app" >/dev/null 2>&1 || true
fi

# Let any asynchronous LaunchServices notifications from moving a legacy bundle
# settle before publishing the replacement with the same input-source ID. An
# explicit unregister of the old path is deliberately avoided: on recent macOS
# that notification can arrive late and remove the newly registered same-ID
# source from the current login session.
/bin/sleep 1

install_and_verify() {
  local binary=$1
  local display_name=$2
  local attempt

  for attempt in 1 2 3; do
    if run_as_console_user "$binary" --install-input-source; then
      /bin/sleep 1
      if run_as_console_user "$binary" --verify-input-source; then
        return 0
      fi
    fi
    echo "$display_name registration attempt $attempt did not persist; retrying." >&2
    /bin/sleep 1
  done

  echo "Could not verify $display_name in the current login session; log out and back in once." >&2
  return 1
}

install_and_verify "$chinese_binary" "LinguaFlow 中文" || true
install_and_verify "$english_binary" "LinguaFlow English" || true

# A second fresh-process check catches the former false-success case where TIS
# returned noErr and a delayed stale-path notification removed the source after
# the helper exited.
/bin/sleep 1
if ! run_as_console_user "$chinese_binary" --verify-input-source; then
  install_and_verify "$chinese_binary" "LinguaFlow 中文" || true
fi
if ! run_as_console_user "$english_binary" --verify-input-source; then
  install_and_verify "$english_binary" "LinguaFlow English" || true
fi

registration_failed=0
run_as_console_user "$chinese_binary" --verify-input-source || registration_failed=1
run_as_console_user "$english_binary" --verify-input-source || registration_failed=1
if [[ "$registration_failed" -ne 0 ]]; then
  echo "LinguaFlow files were installed, but macOS deferred one or more input sources until the next login." >&2
fi

# Input-source state belongs to the current graphical login session. The fixed
# payload remains a valid installation if macOS defers that recoverable session
# refresh until the next login, so do not turn it into a partial-package error.
exit 0
