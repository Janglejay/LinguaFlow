#!/bin/zsh

set -u

# InputMethodKit keeps the active input source process alive. Stop the old
# binaries before Installer replaces their bundles so the next activation
# always loads one coherent version.
/usr/bin/pkill -x LinguaFlowIME >/dev/null 2>&1 || true
/usr/bin/pkill -x LinguaFlowEnglishIME >/dev/null 2>&1 || true
/usr/bin/pkill -x LinguaFlowSetup >/dev/null 2>&1 || true

# Early developer builds lived in ~/Library/Input Methods. A user-domain copy
# with the same bundle identifier can shadow the system-wide package forever.
# Move only the two exact, identifier-matching bundles to a recoverable backup;
# never delete or broadly sweep the user's Input Methods directory.
console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
if [[ -n "$console_user" && "$console_user" != root && "$console_user" != loginwindow ]]; then
  user_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null \
    | /usr/bin/awk '{ $1=""; sub(/^ /, ""); print }')
  user_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null || true)
  user_gid=$(/usr/bin/id -g "$console_user" 2>/dev/null || true)

  if [[ -n "$user_home" && -n "$user_uid" && -n "$user_gid" ]]; then
    backup_stamp=$(/bin/date -u '+%Y%m%dT%H%M%SZ')-$$
    backup_root="$user_home/Library/Application Support/LinguaFlow/Legacy Input Methods Backup/$backup_stamp"

    migrate_legacy_bundle() {
      local bundle_name=$1
      local expected_identifier=$2
      local legacy_bundle="$user_home/Library/Input Methods/$bundle_name"
      local info_plist="$legacy_bundle/Contents/Info.plist"
      local actual_identifier

      [[ -d "$legacy_bundle" && ! -L "$legacy_bundle" && -f "$info_plist" ]] || return
      actual_identifier=$(/usr/libexec/PlistBuddy \
        -c 'Print :CFBundleIdentifier' "$info_plist" 2>/dev/null || true)
      [[ "$actual_identifier" == "$expected_identifier" ]] || return

      if ! /bin/mkdir -p "$backup_root"; then
        echo "Could not create the LinguaFlow legacy-backup directory." >&2
        return
      fi
      if /bin/mv "$legacy_bundle" "$backup_root/$bundle_name"; then
        /usr/sbin/chown -R "$user_uid:$user_gid" "$backup_root"
        echo "Moved legacy $bundle_name to $backup_root"
      else
        echo "Could not move legacy $bundle_name; it was left unchanged." >&2
      fi
    }

    migrate_legacy_bundle \
      LinguaFlow.app com.fufangjie.inputmethod.LinguaFlow
    migrate_legacy_bundle \
      LinguaFlowEnglish.app com.fufangjie.inputmethod.LinguaFlowEnglish
  fi
fi

exit 0
